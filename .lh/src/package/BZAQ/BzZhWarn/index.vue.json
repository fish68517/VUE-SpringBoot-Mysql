            "content": "<template>\r\n  <div class=\"bz-zh-warn\">\r\n    <!-- 左侧区域 -->\r\n    <div class=\"left-area\">\r\n      <!-- 顶部行 -->\r\n      <div class=\"top-header\">\r\n        <div class=\"header-group\">\r\n          <span class=\"location-icon\">📍</span>\r\n          <span class=\"text\">渝中区</span>\r\n        </div>\r\n        <div class=\"divider\"></div>\r\n        <div class=\"header-group\">\r\n          <span class=\"text\">7月28日</span>\r\n        </div>\r\n        <div class=\"divider\"></div>\r\n        <div class=\"header-group\">\r\n          <span class=\"text\">42℃</span>\r\n        </div>\r\n        <div class=\"divider\"></div>\r\n        <div class=\"header-group\">\r\n          <img src=\"./img/Frame.png\" alt=\"风力\" class=\"wind-icon\">\r\n          <span class=\"text\">6级</span>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 预警盒子区域 -->\r\n      <div class=\"warn-boxes\">\r\n        <div\r\n          v-for=\"item in warnTypes\"\r\n          :key=\"item.key\"\r\n          class=\"warn-card\"\r\n          :class=\"[item.key, { active: currentWarn === item.key }]\"\r\n          @click=\"currentWarn = item.key\"\r\n        >\r\n          <div class=\"card-title\">{{ item.title }}</div>\r\n          <div class=\"card-level\" :class=\"item.levelClass\">{{ item.level }}</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 右侧区域 -->\r\n    <div class=\"right-area\">\r\n      <!-- 上方预警信息卡片 -->\r\n      <div class=\"warn-info-card\">\r\n        <div class=\"warn-title\">{{ currentWarnData.title }}</div>\r\n        <div class=\"warn-content\">{{ currentWarnData.content }}</div>\r\n      </div>\r\n\r\n      <!-- 统计表格 -->\r\n      <div class=\"rain-stat\">\r\n        <div class=\"stat-title\">\r\n          <span class=\"arrow\">▶</span>\r\n          {{ currentWarnData.statTitle }}\r\n        </div>\r\n        <div class=\"stat-table\">\r\n          <div class=\"table-row header\">\r\n            <div class=\"table-cell first-col\">{{ currentWarnData.tableFirstCol }}</div>\r\n            <div\r\n              v-for=\"(col, idx) in currentWarnData.columns\"\r\n              :key=\"idx\"\r\n              class=\"table-cell\"\r\n              v-html=\"col\"\r\n            ></div>\r\n          </div>\r\n          <div class=\"table-row\">\r\n            <div class=\"table-cell first-col\">{{ currentWarnData.tableFirstColData }}</div>\r\n            <div\r\n              v-for=\"(num, idx) in currentWarnData.numbers\"\r\n              :key=\"idx\"\r\n              class=\"table-cell\"\r\n            >\r\n              <span class=\"rain-num\" :class=\"num.color\">{{ num.value }}</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport axios from 'axios'\r\nimport { ref, computed, watch, nextTick, onMounted, onBeforeUnmount, defineProps } from 'vue'\r\n\r\nconst props = defineProps({\r\n  chartConfig: {\r\n    type: Object,\r\n    required: true\r\n  }\r\n})\r\n\r\n// 预警类型列表\r\nconst warnTypes = [\r\n  { key: 'rain', title: '降雨预警', level: '黄色', levelClass: 'yellow' },\r\n  { key: 'heat', title: '高温预警', level: '红色', levelClass: 'red' },\r\n  { key: 'wind', title: '大风预警', level: '6级', levelClass: 'cyan' },\r\n  { key: 'fog', title: '大雾预警', level: '黄色', levelClass: 'yellow' },\r\n  { key: 'thunder', title: '雷电预警', level: '黄色', levelClass: 'yellow' },\r\n  { key: 'watershed', title: '小流域预警', level: '无风险', levelClass: 'blue' }\r\n]\r\n\r\n// 当前选中的预警类型\r\nconst currentWarn = ref('rain')\r\n\r\n// 各预警类型对应的数据\r\nconst warnDataMap: Record<string, any> = {\r\n  rain: {\r\n    title: '暴雨黄色预警',\r\n    content: '重庆市气象台2026年7月28日9时20分发布\"暴雨黄色预警信号\"，预计72小时后14日13:00-20:00，菜园坝、大坪、两路口、上清寺、大溪沟、南纪门等11个街道，日最高降雨量达到35mm。',\r\n    statTitle: '未来24小时雨量统计',\r\n    tableFirstCol: '等级',\r\n    tableFirstColData: '街道',\r\n    columns: ['特大暴雨<br>≥250', '大暴雨<br>100~249.9', '暴雨<br>50~99.9', '大雨<br>25~49.9', '中雨<br>10~24.9', '小雨<br>0~9.9'],\r\n    numbers: [\r\n      { value: 0, color: 'red' },\r\n      { value: 0, color: 'orange' },\r\n      { value: 1, color: 'yellow' },\r\n      { value: 5, color: 'yellow' },\r\n      { value: 2, color: 'cyan' },\r\n      { value: 3, color: 'blue' }\r\n    ]\r\n  },\r\n  heat: {\r\n    title: '高温红色预警',\r\n    content: '重庆市气象台2026年7月28日9时50分发布\"高温红色预警信号\"，预计28日13:00-21:00，菜园坝、大坪、两路口、上清寺、大溪沟、南纪门、七星岗、解放碑、化龙桥、朝天门、石油路等11个街道，日最高气温将升至40°C以上。',\r\n    statTitle: '未来七日天气预报',\r\n    tableFirstCol: '温度',\r\n    tableFirstColData: '日期',\r\n    columns: ['37~40℃', '37~39℃', '35~36℃', '32~34℃', '28~31℃', '26~28℃'],\r\n    numbers: [\r\n      { value: '7.28', color: 'cyan' },\r\n      { value: '7.29', color: 'cyan' },\r\n      { value: '7.30', color: 'cyan' },\r\n      { value: '7.31', color: 'cyan' },\r\n      { value: '8.1', color: 'cyan' },\r\n      { value: '8.2', color: 'cyan' }\r\n    ]\r\n  },\r\n  wind: {\r\n    title: '大风蓝色预警',\r\n    content: '当前无大风预警，目前风力等级6级，未来24小时风力稳定。',\r\n    statTitle: '未来24小时大风统计',\r\n    tableFirstCol: '等级',\r\n    tableFirstColData: '镇街',\r\n    columns: ['13级及以上<br>≥37.0', '11-12级<br>28.5~36.9', '9-10级<br>20.8~28.4', '7-8级<br>13.9~20.7', '6级及以下<br>≤13.8'],\r\n    numbers: [\r\n      { value: 0, color: 'red' },\r\n      { value: 0, color: 'orange' },\r\n      { value: 0, color: 'yellow' },\r\n      { value: 0, color: 'yellow' },\r\n      { value: 11, color: 'cyan' }\r\n    ]\r\n  },\r\n  fog: {\r\n    title: '大雾黄色预警',\r\n    content: '当前无大雾预警，当前能见度良好。',\r\n    statTitle: '当前能见度统计',\r\n    tableFirstCol: '等级',\r\n    tableFirstColData: '镇街',\r\n    columns: ['5m', '20m', '100m', '200m', '500m'],\r\n    numbers: [\r\n      { value: 0, color: 'red' },\r\n      { value: 0, color: 'orange' },\r\n      { value: 0, color: 'yellow' },\r\n      { value: 0, color: 'yellow' },\r\n      { value: 11, color: 'cyan' }\r\n    ]\r\n  },\r\n  thunder: {\r\n    title: '雷电黄色预警',\r\n    content: '当前无雷电预警，近期24小时无强对流天气。',\r\n    statTitle: '近期24小时闪电统计',\r\n    tableFirstCol: '小时',\r\n    tableFirstColData: '闪电数',\r\n    columns: ['1', '3', '6', '12', '24'],\r\n    numbers: [\r\n      { value: 49, color: 'cyan' },\r\n      { value: 145, color: 'cyan' },\r\n      { value: 190, color: 'cyan' },\r\n      { value: 190, color: 'cyan' },\r\n      { value: 241, color: 'cyan' }\r\n    ]\r\n  }\r\n}\r\n\r\n// 当前预警数据\r\nconst currentWarnData = computed(() => {\r\n  return warnDataMap[currentWarn.value] || warnDataMap.rain\r\n})\r\n</script>\r\n\r\n<script lang=\"ts\">\r\nexport default {\r\n  name: \"BzZhWarn\",\r\n  version: \"1.0.0\",\r\n};\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n.bz-zh-warn {\r\n  width: 1070px;\r\n  height: 224px;\r\n  box-sizing: border-box;\r\n  overflow: hidden;\r\n  display: flex;\r\n  color: #fff;\r\n  font-family: 'BzAlibabaPuHuiTi', Microsoft YaHei, PingFang SC, Arial, sans-serif;\r\n}\r\n\r\n// 左侧区域\r\n.left-area {\r\n  width: 428px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n}\r\n\r\n// 顶部行\r\n.top-header {\r\n  width: 428px;\r\n  height: 48px;\r\n  background: url('./img/Rectangle_346242393.png') no-repeat center / cover;\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 16px;\r\n  gap: 16px;\r\n  border-radius: 4px;\r\n  box-sizing: border-box;\r\n\r\n  .header-group {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n\r\n    .location-icon {\r\n      font-size: 22px;\r\n      color: #bffcff;\r\n    }\r\n\r\n    .wind-icon {\r\n      height: 22px;\r\n      width: auto;\r\n    }\r\n\r\n    .text {\r\n      font-size: 22px;\r\n      font-style: normal;\r\n      font-weight: 800;\r\n      line-height: normal;\r\n      text-align: center;\r\n      font-family: \"Alibaba PuHuiTi 2.0\"; \r\n      background: linear-gradient(0deg, #5FBCFF 1.4%, #FFF 58.67%); \r\n      background-clip: text; \r\n      -webkit-background-clip: text; \r\n      -webkit-text-fill-color: transparent;\r\n    }\r\n  }\r\n\r\n  .divider {\r\n    width: 2px;\r\n    height: 24px;\r\n    background: rgba(191, 252, 255, 0.3);\r\n  }\r\n}\r\n\r\n// 预警盒子区域\r\n.warn-boxes {\r\n  width: 428px;\r\n  height: 164px;\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 16px 16px;\r\n}\r\n\r\n.warn-card {\r\n  width: 132px;\r\n  height: 74px;\r\n  background: url('./img/Group 2136641308.png') no-repeat center / cover;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: flex-start;\r\n  padding-top: 2px;\r\n  border-radius: 4px;\r\n  box-sizing: border-box;\r\n\r\n  .card-title {\r\n    text-align: center;\r\n    font-family: \"Alibaba PuHuiTi 2.0\"; \r\n    font-size: 16px; \r\n    font-style: normal; \r\n    font-weight: 800; \r\n    line-height: normal; \r\n    background: linear-gradient(0deg, #5FBCFF 1.4%, #FFF 58.67%); \r\n    background-clip: text; \r\n    -webkit-background-clip: text; \r\n    -webkit-text-fill-color: transparent;\r\n  }\r\n\r\n  .card-level {\r\n    margin-top: auto;\r\n    margin-bottom: 8px;\r\n    color: var(--Font-Font-8, #FFBC00); \r\n    font-feature-settings: 'liga' off, 'clig' off; \r\n    font-family: \"Alibaba PuHuiTi 2.0\"; \r\n    font-size: 24px; \r\n    font-style: normal; \r\n    font-weight: 800; \r\n    line-height: normal; \r\n    letter-spacing: 0.48px;\r\n\r\n    &.yellow {\r\n      background: linear-gradient(180deg, #FFD700 0%, #FFF8C0 100%);\r\n      -webkit-background-clip: text;\r\n      -webkit-text-fill-color: transparent;\r\n    }\r\n    &.red {\r\n      background: linear-gradient(180deg, #FF4444 0%, #FFCCCC 100%);\r\n      -webkit-background-clip: text;\r\n      -webkit-text-fill-color: transparent;\r\n    }\r\n    &.cyan {\r\n      background: linear-gradient(180deg, #00FFFF 0%, #CCFFFF 100%);\r\n      -webkit-background-clip: text;\r\n      -webkit-text-fill-color: transparent;\r\n    }\r\n    &.blue {\r\n      background: linear-gradient(180deg, #44AAFF 0%, #CCEEFF 100%);\r\n      -webkit-background-clip: text;\r\n      -webkit-text-fill-color: transparent;\r\n    }\r\n  }\r\n}\r\n\r\n// 各卡片单独背景\r\n.warn-card.heat {\r\n  background: url('./img/Group_2136641308_1.png') no-repeat center / cover;\r\n}\r\n.warn-card.wind {\r\n  background: url('./img/Group_2136641308_2.png') no-repeat center / cover;\r\n}\r\n.warn-card.watershed {\r\n  background: url('./img/Group_2136641308_3.png') no-repeat center / cover;\r\n}\r\n\r\n// 右侧区域\r\n.right-area {\r\n  width: 626px;\r\n  margin-left: 16px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 3px;\r\n}\r\n\r\n// 预警信息卡片\r\n.warn-info-card {\r\n  width: 626px;\r\n  height: 110px;\r\n  background: url('./img/Group 2136641333.png') no-repeat center / 100% 100%;\r\n  border-radius: 4px;\r\n  padding: 8px 12px;\r\n  box-sizing: border-box;\r\n\r\n  .warn-title {\r\n    font-size: 20px;\r\n    font-weight: 800;\r\n    color: #FFD700;\r\n    margin-bottom: 4px;\r\n  }\r\n\r\n  .warn-content {\r\n    font-size: 14px;\r\n    line-height: 1.4;\r\n    color: #e0f0ff;\r\n    max-height: 70px;\r\n    overflow-y: auto;\r\n    text-align: justify;\r\n    padding-right: 4px;\r\n  }\r\n}\r\n\r\n// 雨量统计\r\n.rain-stat {\r\n  width: 626px;\r\n  height: 111px;\r\n\r\n  .stat-title {\r\n    font-size: 16px;\r\n    font-weight: 600;\r\n    background: linear-gradient(0deg, #5FBCFF 1.4%, #FFF 58.67%); \r\n    background-clip: text; \r\n    -webkit-background-clip: text; \r\n    -webkit-text-fill-color: transparent;\r\n    margin-bottom: 8px;\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n\r\n    .arrow {\r\n      color: #5FBCFF;\r\n      font-size: 14px;\r\n    }\r\n  }\r\n\r\n  .stat-table {\r\n    .table-row {\r\n      display: grid;\r\n      grid-template-columns: 80px repeat(v-bind('currentWarnData.columns.length'), 1fr);\r\n      height: 40px;\r\n      border: 1px solid rgba(95, 188, 255, 0.3);\r\n\r\n      .table-cell {\r\n        display: flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n        border-right: 1px solid rgba(95, 188, 255, 0.3);\r\n        font-size: 14px;\r\n        color: #e0f0ff;\r\n        text-align: center;\r\n\r\n        &:last-child {\r\n          border-right: none;\r\n        }\r\n\r\n        &.first-col {\r\n          font-size: 12px;\r\n        }\r\n\r\n        .rain-num {\r\n          font-size: 20px;\r\n          font-weight: 800;\r\n\r\n          &.red {\r\n            color: #FF4444;\r\n          }\r\n          &.orange {\r\n            color: #FF9900;\r\n          }\r\n          &.yellow {\r\n            color: #FFD700;\r\n          }\r\n          &.cyan {\r\n            color: #00FFFF;\r\n          }\r\n          &.blue {\r\n            color: #44AAFF;\r\n          }\r\n        }\r\n      }\r\n\r\n      &.header {\r\n        background: #08356C;\r\n        .table-cell {\r\n          color: #87e8ff;\r\n          font-size: 12px;\r\n          font-weight: 500;\r\n        }\r\n      }\r\n\r\n      &:not(.header) {\r\n        background: #0A2D5D;\r\n      }\r\n    }\r\n  }\r\n}\r\n</style>"
        }
    ]
}