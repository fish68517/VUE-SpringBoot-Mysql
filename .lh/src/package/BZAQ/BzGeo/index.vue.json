            "content": "<template>\n  <div class=\"bz-geo\">\n    <aside class=\"side-tabs\">\n      <div\n        v-for=\"item in sideMenus\"\n        :key=\"item.label\"\n        class=\"side-tabs__item\"\n        :class=\"item.className\"\n      >\n        {{ item.label }}\n      </div>\n    </aside>\n\n    <main class=\"content\">\n      <section class=\"grid-patrol\">\n        <div class=\"patrol-left\">\n          <div class=\"danger-row\">\n            <img src=\"./img/text-low-bg.png\" alt=\"\" />\n            <div class=\"danger-info\">\n              <div class=\"danger-label\">地灾隐患点</div>\n              <div class=\"danger-value danger-value--yellow\">15</div>\n            </div>\n          </div>\n          <div class=\"danger-row\">\n            <img src=\"./img/stat-card-round.png\" alt=\"\" />\n            <div class=\"danger-info\">\n              <div class=\"danger-label\">四重网格员</div>\n              <div class=\"danger-value\">32</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"patrol-cards\">\n          <div v-for=\"item in gridStats\" :key=\"item.label\" class=\"patrol-card\">\n            <img :src=\"item.icon\" alt=\"\" />\n            <div class=\"patrol-card__label\">{{ item.label }}</div>\n            <div class=\"patrol-card__value\">\n              {{ item.value }}<span>{{ item.unit }}</span>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"disaster-warning\">\n        <div class=\"warning-metrics\">\n          <div v-for=\"item in warningStats\" :key=\"item.label\" class=\"warning-metric\">\n            <div class=\"warning-metric__num\">\n              {{ item.value }}<span>起</span>\n            </div>\n            <div class=\"warning-metric__base\"></div>\n            <div class=\"warning-metric__label\"><span>{{ item.label }}</span></div>\n          </div>\n        </div>\n\n        <div class=\"warning-message-list\">\n          <div v-for=\"item in warningMessages\" :key=\"item.text\" class=\"warning-message\">\n            <span :class=\"['warning-message__tag', item.type]\">{{ item.tag }}</span>\n            <span class=\"warning-message__text\">{{ item.text }}</span>\n            <span class=\"warning-message__date\">{{ item.date }}</span>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"disaster-disposal\">\n        <div class=\"disposal-metrics\">\n          <div v-for=\"item in disasterTabs\" :key=\"item.label\" class=\"disposal-metric\">\n            <span class=\"disposal-metric__label\">{{ item.label }}</span>\n            <span class=\"disposal-metric__value\">\n              <strong>{{ item.value }}</strong><em>/11</em>\n            </span>\n          </div>\n        </div>\n\n        <n-data-table\n          class=\"disposal-table\"\n          :columns=\"dangerColumns\"\n          :data=\"dangerRows\"\n          :pagination=\"false\"\n          :bordered=\"false\"\n          size=\"small\"\n        />\n\n        <div class=\"disposal-title\">处置情况</div>\n        <n-carousel\n          class=\"disposal-carousel\"\n          :show-dots=\"false\"\n          :show-arrow=\"false\"\n          autoplay\n        >\n          <div class=\"disposal-slide\">\n            <div v-for=\"item in handleCards\" :key=\"item.name\" class=\"disposal-card\">\n              <n-image\n                class=\"disposal-card__image\"\n                :src=\"item.img\"\n                object-fit=\"cover\"\n                preview-disabled\n              />\n              <div class=\"disposal-card__text\">{{ item.name }}</div>\n            </div>\n          </div>\n        </n-carousel>\n      </section>\n\n      <section class=\"project-governance\">\n        <div v-for=\"item in projectStats\" :key=\"item.label\" class=\"project-governance__item\">\n          <div class=\"project-governance__value\">\n            <strong>{{ item.value }}</strong><span>个</span>\n          </div>\n          <div class=\"project-governance__label\">{{ item.label }}</div>\n        </div>\n      </section>\n    </main>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { h } from 'vue'\nimport { NCarousel, NDataTable, NImage } from 'naive-ui'\n\nconst props = defineProps({\n  chartConfig: {\n    type: Object,\n    required: true\n  },\n  publicParamList: {\n    type: Object,\n    required: false,\n    default: () => []\n  },\n  bus: {\n    type: Object,\n    required: false\n  }\n})\n\nconst sourceName = 'BzGeo'\nconst dangerIcon = require('./img/icon_dangers_blue.png')\nconst patrolIcon = require('./img/icon-danger-patrol.png')\nconst finishIcon = require('./img/icon-danger-grid.png')\nconst handleImage = require('./img/frame-thumb.png')\n\nconst sideMenus = [\n  { label: '网格巡查', className: 'side-tabs__item--patrol' },\n  { label: '地灾预警', className: 'side-tabs__item--warning' },\n  { label: '临灾处置', className: 'side-tabs__item--dispose' },\n  { label: '工程治理', className: 'side-tabs__item--project' }\n]\nconst gridStats = [\n  { label: '今日巡查点位', value: 23, unit: '个', icon: dangerIcon },\n  { label: '已完成巡查', value: 32, unit: '个', icon: finishIcon },\n  { label: '巡查完成率', value: 99, unit: '%', icon: patrolIcon }\n]\nconst warningStats = [\n  { label: '设备告警', value: 15 },\n  { label: '形变', value: 19 },\n  { label: '位移', value: 22 },\n  { label: '地灾预警', value: 6 },\n  { label: '小流域预警', value: 22 }\n]\nconst warningMessages = [\n  { tag: '预警', type: 'warn', text: '这里是一条小流域预警信息', date: '2026-05-23' },\n  { tag: '告警', type: 'alarm', text: '这一条设备告警信息', date: '2026-05-22' }\n]\nconst disasterTabs = [\n  { label: '灾情', value: 11 },\n  { label: '险情', value: 11 }\n]\nconst dangerRows = Array.from({ length: 6 }).map((_, index) => ({\n  id: index + 1,\n  name: '鹅岭公园滑坡',\n  event: '鹅岭公园发生滑坡事件',\n  level: '一般',\n  time: '05-05'\n}))\nconst dangerColumns = [\n  { title: '序号', key: 'id', width: 44, align: 'center' },\n  { title: '灾险情名称', key: 'name', width: 116 },\n  { title: '发生事件', key: 'event', width: 152 },\n  {\n    title: '灾险情等级',\n    key: 'level',\n    width: 88,\n    render(row) {\n      return h('span', { class: 'danger-level' }, row.level)\n    }\n  },\n  { title: '发生时间', key: 'time', width: 76 }\n]\nconst handleCards = [\n  { name: '某某点位', img: handleImage },\n  { name: '某某点位', img: handleImage },\n  { name: '某某点位', img: handleImage }\n]\nconst projectStats = [\n  { label: '项目总数', value: 49 },\n  { label: '正在实施', value: 49 },\n  { label: '已完成', value: 49 }\n]\n\n// 事件总线定义，方便组件间通信，本地暂时不能触发，只能上传测试环境测试,注意emit中的source是组件名称，方便区分事件来源\nconst eventBus = {\n  on: (event, callback) => {\n    props.bus?.on(event, ({ source, data }) => {\n      console.log('🚀 ~ eventBus on:', event, source, data)\n      if (source === sourceName) return\n      callback(data)\n    })\n  },\n  off: (event, callback) => {\n    props.bus?.off(event, callback)\n  },\n  emit: (event, data) => {\n    console.log('🚀 ~ eventBus emit:', event, data)\n    props.bus?.emit(event, { data, source: sourceName })\n  }\n}\n</script>\n\n\n\n<script lang=\"ts\">\nexport default {\n  name: \"BzGeo\",\n  version: \"1.0.0\",\n};\n</script>\n\n<style lang=\"scss\" scoped>\n@font-face {\n  font-family: 'BzAlibabaPuHuiTi';\n  src: url('./font/Alibaba_PuHuiTi_2.0_55_Regular_55_Regular.ttf') format('truetype');\n  font-weight: 400;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'BzAlibabaPuHuiTi';\n  src: url('./font/Alibaba_PuHuiTi_2.0_75_SemiBold_75_SemiBold.ttf') format('truetype');\n  font-weight: 700;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'BzDDIN';\n  src: url('./font/D-DIN.otf') format('opentype');\n  font-weight: 400;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'BzDDIN';\n  src: url('./font/D-DIN-Bold.otf') format('opentype');\n  font-weight: 700 900;\n  font-style: normal;\n  font-display: swap;\n}\n\n.bz-geo {\n  width: 540px;\n  height: 928px;\n  display: flex;\n  box-siz