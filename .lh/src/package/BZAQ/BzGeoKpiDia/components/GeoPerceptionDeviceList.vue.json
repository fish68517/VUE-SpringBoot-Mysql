            "date": 1782972425599,
            "name": "Commit-0",
            "content": "<template>\n  <div class=\"geo-list-modal\">\n    <div class=\"modal-header\">\n      <div class=\"header-title\">感知设备列表</div>\n      <button class=\"close-btn\" @click=\"handleClose\">×</button>\n    </div>\n\n    <div class=\"query-bar\">\n      <n-input\n        v-model:value=\"searchName\"\n        class=\"query-input\"\n        clearable\n        placeholder=\"请输入感知设备名称\"\n        @keyup.enter=\"handleSearch\"\n        style=\"background: #0c3267;\"\n      />\n      <n-select\n        v-model:value=\"selectedType\"\n        class=\"query-select\"\n        :options=\"deviceTypeOptions\"\n        :bordered=\"false\"\n        @update:value=\"handleTypeChange\"\n      />\n      <n-button class=\"query-btn\" size=\"small\" @click=\"handleSearch\">查询</n-button>\n      <n-button class=\"query-btn\" size=\"small\" @click=\"handleReset\">重置</n-button>\n    </div>\n\n    <div class=\"modal-content\">\n      <n-data-table\n        class=\"geo-table\"\n        :columns=\"columns\"\n        :data=\"tableData\"\n        :bordered=\"false\"\n        :single-line=\"false\"\n        size=\"small\"\n      />\n    </div>\n\n    <div class=\"modal-footer\">\n      <n-pagination\n        :page=\"currentPage\"\n        :page-count=\"totalPage\"\n        :page-slot=\"5\"\n        @update:page=\"handlePageChange\"\n      />\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { h, onMounted, ref } from 'vue'\nimport { NButton, NDataTable, NInput, NPagination, NSelect } from 'naive-ui'\nimport axios from 'axios'\n\nconst emit = defineEmits(['close'])\n\nconst BASE_URL = 'http://23.99.16.179:11001/api/boot/system/geo'\nconst currentPage = ref(1)\nconst totalPage = ref(1)\nconst pageSize = 10\nconst tableData = ref([])\nconst searchName = ref('')\nconst selectedType = ref('all')\n\nconst deviceApiMap = {\n  'device-insar': '/list/insar',\n  'device-deformation': '/list/deformation',\n  'device-displacement': '/list/displacement',\n  'device-rainfall': '/list/rainfall',\n  'device-camera': '/list/camera',\n  'device-grid-member': '/list/grid-member'\n}\n\nconst deviceTypeLabelMap = {\n  'device-insar': 'inSAR卫星识别',\n  'device-deformation': '形变监测',\n  'device-displacement': '位移监测',\n  'device-rainfall': '雨量监测',\n  'device-camera': '摄像头',\n  'device-grid-member': '四重网格员'\n}\n\nconst deviceTypeOptions = [\n  { label: '全部', value: 'all' },\n  { label: 'inSAR卫星识别', value: 'device-insar' },\n  { label: '形变监测', value: 'device-deformation' },\n  { label: '位移监测', value: 'device-displacement' },\n  { label: '雨量监测', value: 'device-rainfall' },\n  { label: '摄像头', value: 'device-camera' },\n  { label: '四重网格员', value: 'device-grid-member' }\n]\n\nconst columns = [\n  {\n    title: '序号',\n    key: 'index',\n    width: 80,\n    render(_row, rowIndex) {\n      return h('span', {}, (currentPage.value - 1) * pageSize + rowIndex + 1)\n    }\n  },\n  { title: '感知设备名称', key: 'name', minWidth: 220, ellipsis: true },\n  { title: '感知设备类型', key: 'type', width: 180, ellipsis: true }\n]\n\nconst getResponseRecords = data => {\n  const result = data?.data ?? data\n  const list = Array.isArray(result)\n    ? result\n    : result?.records || result?.list || result?.rows || []\n  return Array.isArray(list) ? list : []\n}\n\nconst getResponsePage = data => {\n  const result = data?.data ?? data\n  return {\n    records: getResponseRecords(data),\n    pages: Number(result?.pages) || 1\n  }\n}\n\nconst getDeviceName = item => {\n  return String(item.name || item.deviceName || item.dvname || item.deviceNum || item.deviceNo || item.dvcode || item.address || '-')\n}\n\nconst getDeviceType = item => {\n  return String(item.deviceTypeName || item.deviceType || item.typeName || item.type || item.categoryName || item.category || deviceTypeLabelMap[selectedType.value] || '-')\n}\n\nconst getQueryParams = pageSizeValue => ({\n  pageNumber: currentPage.value,\n  pageSize: pageSizeValue || pageSize,\n  name: searchName.value || undefined,\n  deviceName: searchName.value || undefined,\n  keyword: searchName.value || undefined\n})\n\nconst fetchByType = async type => {\n  const api = deviceApiMap[type]\n  if (!api) return { records: [], pages: 1 }\n  const res = await axios.post(`${BASE_URL}${api}`, getQueryParams())\n  return getResponsePage(res?.data)\n}\n\nconst fetchAllTypes = async () => {\n  const requests = Object.keys(deviceApiMap).map(async type => {\n    const res = await axios.post(`${BASE_URL}${deviceApiMap[type]}`, {\n      ...getQueryParams(9999),\n      pageNumber: 1\n    })\n    return getResponseRecords(res?.data).map(item => ({\n      ...item,\n      __deviceType: type\n    }))\n  })\n  const records = (await Promise.all(requests)).flat()\n  const filtered = searchName.value\n    ? records.filter(item => getDeviceName(item).includes(searchName.value))\n    : records\n  const start = (currentPage.value - 1) * pageSize\n  return {\n    records: filtered.slice(start, start + pageSize),\n    pages: Math.max(1, Math.ceil(filtered.length / pageSize))\n  }\n}\n\nconst toTableRows = records => {\n  return records.map((item, index) => {\n    const type = item.__deviceType || selectedType.value\n    return {\n      key: item.id || item.deviceCode || item.deviceNum || item.deviceNo || item.dvcode || `${type}_${index}`,\n      name: getDeviceName(item),\n      type: selectedType.value === 'all' ? (deviceTypeLabelMap[type] || getDeviceType(item)) : deviceTypeLabelMap[selectedType.value]\n    }\n  })\n}\n\nconst getDeviceList = async () => {\n  try {\n    const pageData = selectedType.value === 'all'\n      ? await fetchAllTypes()\n      : await fetchByType(selectedType.value)\n    totalPage.value = pageData.pages || 1\n    tableData.value = toTableRows(pageData.records)\n  } catch (error) {\n    console.error('获取感知设备列表失败:', error)\n    tableData.value = []\n    totalPage.value = 1\n  }\n}\n\nfunction handleClose() {\n  emit('close')\n}\n\nfunction handleSearch() {\n  currentPage.value = 1\n  getDeviceList()\n}\n\nfunction handleReset() {\n  searchName.value = ''\n  selectedType.value = 'all'\n  currentPage.value = 1\n  getDeviceList()\n}\n\nfunction handleTypeChange() {\n  currentPage.value = 1\n  getDeviceList()\n}\n\nfunction handlePageChange(page) {\n  currentPage.value = page\n  getDeviceList()\n}\n\nonMounted(() => {\n  getDeviceList()\n})\n</script>\n\n<script>\nexport default {\n  name: 'GeoPerceptionDeviceList'\n}\n</script>\n\n<style lang=\"scss\" scoped>\n@import './geo-list-modal.scss';\n</style>\n"
        }
    ]
}