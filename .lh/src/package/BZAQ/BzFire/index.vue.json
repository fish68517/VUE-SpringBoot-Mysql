0 0 8px rgba(59, 130, 246, 0.6);\r\n      }\r\n    }\r\n  }\r\n}\r\n\r\n// 物联感知「推」模块\r\n.iot-perception {\r\n  &__grid {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    justify-content: space-between;\r\n    padding: 2px;\r\n  }\r\n\r\n  &__item {\r\n    width: 33%;\r\n    height: 32px;\r\n    line-height: 32px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    padding: 0 4px;\r\n    border: 1px solid rgba(56, 189, 248, 0.4);\r\n    background: linear-gradient(180deg, rgba(15, 53, 99, 0.85), rgba(15, 53, 99, 0.45));\r\n    border-radius: 4px;\r\n    box-shadow: inset 0 0 10px rgba(56, 189, 248, 0.1);\r\n    margin-top: 4px;\r\n  }\r\n\r\n   \r\n    &__item:nth-child(4),\r\n    &__item:nth-child(5) {\r\n      width: 48%;\r\n    }\r\n\r\n\r\n\r\n  &__label {\r\n    font-size: 15px;\r\n    color: #bfdbfe;\r\n    font-weight: 500;\r\n    cursor: pointer;\r\n  }\r\n\r\n  &__value {\r\n    font-family: 'BzDDIN', Arial, sans-serif;\r\n    font-size: 16px;\r\n    color: #bfdbfe;\r\n\r\n    .highlight {\r\n      color: #fbbf24;\r\n      font-weight: 700;\r\n      font-size: 18px;\r\n      text-shadow: 0 0 8px rgba(251, 191, 36, 0.6);\r\n    }\r\n  }\r\n\r\n  &__warning {\r\n    padding: 0 12px 12px;\r\n\r\n    &-title {\r\n      display: flex;\r\n      align-items: center;\r\n      font-size: 16px;\r\n      font-weight: 600;\r\n      color: #bfdbfe;\r\n      margin-bottom: 5px;\r\n\r\n      .arrow {\r\n        width: 0;\r\n        height: 0;\r\n        border-top: 5px solid transparent;\r\n        border-bottom: 5px solid transparent;\r\n        border-left: 7px solid #ADD8FD;\r\n        margin-right: 8px;\r\n      }\r\n    }\r\n\r\n    &-list {\r\n      display: flex;\r\n      gap: 12px;\r\n    }\r\n\r\n    &-item {\r\n      flex: 1;\r\n      border: 1px solid rgba(56, 189, 248, 0.4);\r\n      border-radius: 4px;\r\n      overflow: hidden;\r\n      box-shadow: 0 0 8px rgba(56, 189, 248, 0.2);\r\n\r\n      img {\r\n        w