            "date": 1782556682539,
            "name": "Commit-0",
            "content": "<template>\r\n  <div class=\"bz-fire\">\r\n    <!-- 左侧侧边栏 -->\r\n    <aside class=\"side-bar\">\r\n      <div class=\"side-bar__item side-bar__item--fire\">\r\n        <span class=\"side-bar__item-text\">灭</span>\r\n        <span>火</span>\r\n      </div>\r\n      <div class=\"side-bar__item side-bar__item--prevention\">\r\n        <span>防</span>\r\n        <span>火</span>\r\n      </div>\r\n    </aside>\r\n\r\n    <main class=\"content\">\r\n      <!-- 消防系统「接」模块 -->\r\n      <section class=\"module fire-system\">\r\n        <div class=\"module__header\">\r\n          <div class=\"module__header-title\">消防系统“接”</div>\r\n        </div>\r\n        <div class=\"fire-system__top\">\r\n          <div class=\"fire-system__card\">\r\n            <div class=\"fire-system__card-info\">\r\n              <div class=\"fire-system__card-label\" @click=\"openFireDialog('fire-scene-list', 1)\">火灾扑救</div>\r\n              <div class=\"fire-system__card-value\">{{ fireFightTaskCount }}</div>\r\n            </div>\r\n          </div>\r\n          <div class=\"fire-system__card1 fire-system__card--gold\">\r\n            <div class=\"fire-system__card-info\">\r\n              <div class=\"fire-system__card-label\" @click=\"openFireDialog('fire-scene-list', 2)\">重大火情</div>\r\n              <div class=\"fire-system__card-value\">{{ majorFireCount }}</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"fire-system__bottom\">\r\n          <div class=\"fire-system__stat\">\r\n            <div class=\"fire-system__stat-label\" @click=\"openFireDialog('fire-scene-list', 3)\">火灾舆情</div>\r\n            <div class=\"fire-system__stat-value\">{{ fireOpinionCount }}</div>\r\n          </div>\r\n          <div class=\"fire-system__stat\">\r\n            <div class=\"fire-system__stat-label\" @click=\"openFireDialog('fire-scene-list', 4)\">抢险救援</div>\r\n            <div class=\"fire-system__stat-value fire-system__stat-value--cyan\">{{ rescueMissionCount }}</div>\r\n          </div>\r\n          <div class=\"fire-system__stat\">\r\n            <div class=\"fire-system__stat-label\" @click=\"openFireDialog('fire-scene-list', 5)\">社会救助</div>\r\n            <div class=\"fire-system__stat-value fire-system__stat-value--blue\">{{ socialAssistanceCount }}</div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- 物联感知「推」模块 -->\r\n      <section class=\"module iot-perception\">\r\n        <div class=\"module__header\">\r\n          <div class=\"module__header-title\">物联感知“推”</div>\r\n        </div>\r\n        <div class=\"iot-perception__grid\">\r\n          <div class=\"iot-perception__item\" v-for=\"item in iotStats\" :key=\"item.label\">\r\n            <div class=\"iot-perception__label\" @click=\"openFireDialog(item.key)\">{{ item.label }}</div>\r\n            <div class=\"iot-perception__value\">\r\n              <span class=\"highlight\">{{ item.current }}</span\r\n              >/{{ item.total }}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"iot-perception__warning\">\r\n          <div class=\"iot-perception__warning-title\">\r\n            <span class=\"arrow\"></span>\r\n            预警现场\r\n          </div>\r\n          <div class=\"iot-perception__warning-list\">\r\n            <div class=\"iot-perception__warning-item\" v-for=\"item in warningSites\" :key=\"item.name\">\r\n              <img :src=\"item.img\" alt=\"\" />\r\n              <div class=\"iot-perception__warning-name\">{{ item.name }}</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- 网格群众「报」模块 -->\r\n      <section class=\"module grid-report\">\r\n        <div class=\"module__header\">\r\n          <div class=\"module__header-icon\"></div>\r\n          <div class=\"module__header-title\">网格群众“报”</div>\r\n        </div>\r\n        <div class=\"grid-report__grid\">\r\n          <div class=\"grid-report__card\">\r\n            <div class=\"grid-report__card-title\" @click=\"openFireDialog('grid-inspection-hidden')\">网格巡查隐患</div>\r\n            <div class=\"grid-report__card-item\">\r\n              <span class=\"label\">未整改</span>\r\n              <span class=\"value\">{{ hiddenDangerUnCorrectionNum }}</span>\r\n            </div>\r\n            <div class=\"grid-report__card-item\">\r\n              <span class=\"label\">已整改</span>\r\n              <span class=\"value value--cyan\">{{ hiddenDangerCorrectionNum }}</span>\r\n            </div>\r\n            <div class=\"progress-bar\">\r\n              <div\r\n                class=\"progress-bar__fill\"\r\n                :style=\"{\r\n                  width: `${\r\n                    hiddenDangerCorrectionNum + hiddenDangerUnCorrectionNum > 0\r\n                      ? Math.min(\r\n                          100,\r\n                          Math.round(\r\n                            (hiddenDangerCorrectionNum / (hiddenDangerCorrectionNum + hiddenDangerUnCorrectionNum)) *\r\n                              100\r\n                          )\r\n                        )\r\n                      : 0\r\n                  }%`\r\n                }\"\r\n              ></div>\r\n            </div>\r\n          </div>\r\n          <div class=\"grid-report__card\">\r\n            <div class=\"grid-report__card-title\" @click=\"openFireDialog('fire-radom')\">双随机隐患</div>\r\n            <div class=\"grid-report__card-item\">\r\n              <span class=\"label\">未完成</span>\r\n              <span class=\"value\">{{ doubleRandomUnCorrectionNum }}</span>\r\n            </div>\r\n            <div class=\"grid-report__card-item\">\r\n              <span class=\"label\">已完成</span>\r\n              <span class=\"value value--cyan\">{{ doubleRandomCorrectionNum }}</span>\r\n            </div>\r\n            <div class=\"progress-bar\">\r\n              <div\r\n                class=\"progress-bar__fill\"\r\n                :style=\"{\r\n                  width: `${\r\n                    doubleRandomCorrectionNum + doubleRandomUnCorrectionNum > 0\r\n                      ? Math.min(\r\n                          100,\r\n                          Math.round(\r\n                            (doubleRandomCorrectionNum / (doubleRandomCorrectionNum + doubleRandomUnCorrectionNum)) *\r\n                              100\r\n                          )\r\n                        )\r\n                      : 0\r\n                  }%`\r\n                }\"\r\n              ></div>\r\n            </div>\r\n          </div>\r\n          <div class=\"grid-report__stat\" >\r\n            <div class=\"grid-report__stat-label\" @click=\"openFireDialog('fire-work-hidden')\">近期动火作业隐患</div>\r\n            <div class=\"grid-report__stat-value\">\r\n              <span class=\"num\">{{ hotWorkCorrectionNum }}</span>\r\n              <span class=\"unit\">起</span>\r\n            </div>\r\n            <div class=\"grid-report__stat-icon\">\r\n              <div></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n\r\n      <!-- 管理单位「巡」模块 -->\r\n      <section class=\"module management-patrol\">\r\n        <div class=\"module__header\">\r\n          <div class=\"module__header-icon\"></div>\r\n          <div class=\"module__header-title\">管理单位“巡”</div>\r\n        </div>\r\n        <div class=\"management-patrol__grid\">\r\n          <div class=\"management-patrol__card\">\r\n            <div class=\"management-patrol__card-title\" @click=\"openFireDialog('fire-patrol-missing')\">\r\n              <span class=\"dot dot--yellow\"></span>\r\n              近期防火巡查不到位\r\n            </div>\r\n            <div class=\"management-patrol__card-stats\">\r\n              <div class=\"management-patrol__stat\">\r\n                <span class=\"label\">完成率</span>\r\n                <span class=\"value value--cyan\">{{ checkRate }}</span>\r\n                <span class=\"value value--icon\">%</span>\r\n              </div>\r\n              <div class=\"management-patrol__stat\">\r\n                <span class=\"label\">未检查</span>\r\n                <span class=\"value value--yellow\">{{ notCheckCount }}</span>\r\n                <span class=\"value value--icon\">栋</span>\r\n              </div>\r\n            </div>\r\n            <div class=\"chart-area\">\r\n              <div ref=\"chart1Ref\" class=\"chart-container\"></div>\r\n            </div>\r\n          </div>\r\n          <div class=\"management-patrol__card\">\r\n            <div class=\"management-patrol__card-title\" @click=\"openFireDialog('fire-maintenance-missing')\">\r\n              <span class=\"dot dot--yellow\"></span>\r\n              近期未开展消防设施维保\r\n            </div>\r\n            <div class=\"management-patrol__card-stats\">\r\n              <div class=\"management-patrol__stat\">\r\n                <span class=\"label\" >完成率</span>\r\n                <span class=\"value value--cyan\">{{ maintRate }}</span>\r\n                <span class=\"value value--icon\">%</span>\r\n              </div>\r\n              <div class=\"management-patrol__stat\">\r\n                <span class=\"label\">未检查</span>\r\n                <span class=\"value value--yellow\">{{ notMaintCount }}</span>\r\n                <span class=\"value value--icon\">栋</span>\r\n              </div>\r\n            </div>\r\n            <div class=\"chart-area\">\r\n              <div ref=\"chart2Ref\" class=\"chart-container\"></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n    </main>\r\n  </div>\r\n\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { h, ref, onMounted, onUnmounted } from 'vue'\r\nimport { NCarousel, NDataTable, NImage } from 'naive-ui'\r\nimport axios from 'axios'\r\nimport Bzfire from '../BzFireDia/index.vue'\r\n\r\nconst props = defineProps({\r\n  chartConfig: {\r\n    type: Object,\r\n    required: true\r\n  },\r\n  publicParamList: {\r\n    type: Object,\r\n    required: false,\r\n    default: () => []\r\n  },\r\n  bus: {\r\n    type: Object,\r\n    required: false\r\n  }\r\n})\r\n\r\nconst sourceName = 'BzFire'\r\nconst handleImage = require('./img/bg_left_top01.png')\r\n// 弹窗组件引用，用于访问暴露的eventBus\r\nconst fireDiaRef = ref(null)\r\n\r\n// 图表引用\r\nconst chart1Ref = ref<HTMLElement>()\r\nconst chart2Ref = ref<HTMLElement>()\r\nlet chart1: echarts.ECharts | null = null\r\nlet chart2: echarts.ECharts | null = null\r\n\r\n// 响应式统计数据\r\nconst fireFightTaskCount = ref(0) // 火灾扑救数\r\nconst majorFireCount = ref(0) // 重大火情数\r\nconst fireOpinionCount = ref(0) // 火灾舆情数\r\nconst rescueMissionCount = ref(0) // 抢险救援数\r\nconst socialAssistanceCount = ref(0) // 社会救助数\r\n\r\n// 物联感知统计数据\r\nconst iotStats =ref([\r\n  { label: '消防车保障', current: 0, total: 0,key:'fire-passage-smooth' },\r\n  { label: '消防水管监管', current: 0, total: 0,key:'fire-water' },\r\n  { label: '消控室监测', current: 0, total: 0,key:'fire-cotrol' },\r\n  { label: '重点点位燃气泄露监测', current: 0, total: 0,key:'fire-gas' },\r\n  { label: '公共重点区域化粪池监管', current: 0, total: 0,key:'fire-septic' }\r\n])\r\n\r\n// 网格群众数据\r\nconst hiddenDangerUnCorrectionNum = ref(0) // 未整改\r\nconst hiddenDangerCorrectionNum = ref(0) // 已整改\r\nconst doubleRandomUnCorrectionNum = ref(0) // 未完成\r\nconst doubleRandomCorrectionNum = ref(0) // 已完成\r\nconst hotWorkCorrectionNum = ref(0) // 动火作业隐患\r\n\r\n// 管理单位数据\r\nconst checkRate = ref('0') // 巡查完成率\r\nconst notCheckCount = ref(0) // 未检查数量\r\nconst maintRate = ref('0') // 维保完成率\r\nconst notMaintCount = ref(23) // 未维保数量\r\n\r\n// 预警现场数据\r\nconst warningSites = [\r\n  { name: '某某点位', img: handleImage },\r\n  { name: '某某点位', img: handleImage },\r\n  { name: '某某点位', img: handleImage }\r\n]\r\n\r\n// 接口基础地址\r\nconst BASE_URL = 'http://23.99.16.179:11001/api/boot/system/fire'\r\n\r\n// 查询统计数据\r\nconst getSafeStatistics = async () => {\r\n  try {\r\n    const res = await axios.get(`${BASE_URL}/safeStatistics`)\r\n    console.log(res.data)\r\n    \r\n    if (res.data.code === '000000') {\r\n      const data = res.data.data\r\n\r\n      // 消防系统「接」模块数据\r\n      fireFightTaskCount.value = data.fireFightTaskCount || 0\r\n      majorFireCount.value = data.majorFireCount || 0\r\n      fireOpinionCount.value = data.fireOpinionCount || 0\r\n      rescueMissionCount.value = data.rescueMissionCount || 0\r\n      socialAssistanceCount.value = data.socialAssistanceCount || 0\r\n\r\n      // 物联感知「推」模块数据\r\n      iotStats.value = [\r\n        { label: '消防车保障', current: data.fireTruckOccupyWarnCount || 0, total: data.fireTruckOccupyTotal || 0,key:'fire-passage-smooth' },\r\n        { label: '消防水管监管', current: data.fireWaterGjCount || 0, total: data.fireWaterTotal || 0,key:'fire-water' },\r\n        { label: '消控室监测', current: data.fireControlRoomGjCount || 0, total: data.fireControlRoomTotal || 0,key:'fire-cotrol' },\r\n        { label: '重点点位燃气泄露监测', current: data.gasLeakGjCount || 0, total: data.gasLeakTotal || 0,key:'fire-gas' },\r\n        { label: '公共重点区域化粪池监管', current: data.septicTankGjCount || 0, total: data.septicTankTotal || 0 ,key:'fire-septic'}\r\n      ]\r\n\r\n      // 网格群众「报」模块数据\r\n      hiddenDangerUnCorrectionNum.value = data.hiddenDangerUnCorrectionNum || 0\r\n      hiddenDangerCorrectionNum.value = data.hiddenDangerCorrectionNum || 0\r\n      doubleRandomUnCorrectionNum.value = data.doubleRandomUnCorrectionNum || 0\r\n      doubleRandomCorrectionNum.value = data.doubleRandomCorrectionNum || 0\r\n      hotWorkCorrectionNum.value = data.hotWorkCorrectionNum || 0\r\n\r\n      // 管理单位「巡」模块数据，处理百分比格式，保留整数去掉百分号\r\n      checkRate.value = data.checkRate ? Math.round(parseFloat(data.checkRate)).toString() : '0'\r\n      notCheckCount.value = data.notCheckCount || 0\r\n      maintRate.value = data.maintRate ? Math.round(parseFloat(data.maintRate)).toString() : '0'\r\n      notMaintCount.value = data.notMaintCount || 0\r\n    } else {\r\n      console.error('获取统计数据失败：' + res.data.message)\r\n    }\r\n  } catch (err) {\r\n    console.error('请求统计接口失败', err)\r\n  }\r\n}\r\n\r\n// 图表通用配置\r\nconst getChartOption = (data: number[]) => {\r\n  return {\r\n    backgroundColor: 'transparent',\r\n    grid: {\r\n      left: '0%',\r\n      right: '0%',\r\n      top: '10%',\r\n      bottom: '0%',\r\n      containLabel: true\r\n    },\r\n    xAxis: {\r\n      type: 'category',\r\n      data: ['1月', '2月', '3月', '4月'],\r\n      axisLine: {\r\n        show: true,\r\n        lineStyle: {\r\n          color: 'rgba(139, 188, 230, 0.3)'\r\n        }\r\n      },\r\n      axisLabel: {\r\n        color: '#8bbce6',\r\n        fontSize: 11\r\n      },\r\n      axisTick: {\r\n        show: false\r\n      }\r\n    },\r\n    yAxis: {\r\n      type: 'value',\r\n      min: 0,\r\n      max: 80,\r\n      splitNumber: 3,\r\n      splitLine: {\r\n        show: true,\r\n        lineStyle: {\r\n          color: 'rgba(139, 188, 230, 0.2)',\r\n          type: 'dashed'\r\n        }\r\n      },\r\n      axisLine: {\r\n        show: false\r\n      },\r\n      axisLabel: {\r\n        color: '#8bbce6',\r\n        fontSize: 11\r\n      },\r\n      axisTick: {\r\n        show: false\r\n      }\r\n    },\r\n    legend: {\r\n      data: ['去年', '今年'],\r\n      right: '10%',\r\n      top: 0,\r\n      itemWidth: 10,\r\n      itemHeight: 6,\r\n      textStyle: {\r\n        color: '#8bbce6',\r\n        fontSize: 10\r\n      }\r\n    },\r\n    series: [\r\n      {\r\n        name: '去年',\r\n        type: 'bar',\r\n        data: [60, 55, 40, 10],\r\n        barWidth: 10,\r\n        itemStyle: {\r\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\r\n            { offset: 0.732, color: '#0085ff' },\r\n            { offset: 1, color: '#0085ff26' }\r\n          ]),\r\n          borderRadius: [2, 2, 0, 0]\r\n        }\r\n      },\r\n      {\r\n        name: '今年',\r\n        type: 'bar',\r\n        data: data,\r\n        barWidth: 10,\r\n        itemStyle: {\r\n          color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\r\n            { offset: 0.7, color: '#35FFF4' },\r\n            { offset: 1, color: '#35fff41a' }\r\n          ]),\r\n          borderRadius: [2, 2, 0, 0]\r\n        }\r\n      }\r\n    ]\r\n  }\r\n}\r\n\r\n// 初始化图表\r\nconst initCharts = () => {\r\n  if (chart1Ref.value) {\r\n    chart1 = echarts.init(chart1Ref.value)\r\n    chart1.setOption(getChartOption([30, 20, 50, 20]))\r\n  }\r\n\r\n  if (chart2Ref.value) {\r\n    chart2 = echarts.init(chart2Ref.value)\r\n    chart2.setOption(getChartOption([30, 20, 50, 20]))\r\n  }\r\n}\r\n\r\n// 窗口大小变化时自适应\r\nconst handleResize = () => {\r\n  chart1?.resize()\r\n  chart2?.resize()\r\n}\r\n\r\nonMounted(() => {\r\n  initCharts()\r\n  getSafeStatistics() // 页面加载时请求接口数据\r\n  window.addEventListener('resize', handleResize)\r\n})\r\n\r\nonUnmounted(() => {\r\n  chart1?.dispose()\r\n  chart2?.dispose()\r\n  window.removeEventListener('resize', handleResize)\r\n})\r\n\r\n// 事件总线定义，使用弹窗组件暴露的eventBus\r\nconst eventBus = {\r\n  on(event, callback) {\r\n    if (!props.bus) return\r\n    props.bus.on(event, ({ source, data }) => {\r\n      if (source === sourceName) return\r\n      callback(data)\r\n    })\r\n  },\r\n  off(event, callback) {\r\n    if (!props.bus) return\r\n    props.bus.off(event, callback)\r\n  },\r\n  emit(event, data) {\r\n    if (!props.bus) return\r\n    props.bus.emit(event, { data, source: sourceName })\r\n  }\r\n}\r\n\r\n// 打开弹窗\r\nfunction openFireDialog(diaName: string, type?: number) {\r\n  closeFireDialog()\r\n  const data = { diaName, type: type || null }\r\n  // console.log('data',data)\r\n  eventBus.emit('OPEN_DIA', data)\r\n  // console.log(fireDiaRef.value.openPopup);\r\n  // fireDiaRef.value.openPopup(data)\r\n  \r\n}\r\n\r\n// 关闭弹窗\r\nfunction closeFireDialog() {\r\n  eventBus.emit('CLOSE_DIA', {})\r\n}\r\n</script>\r\n\r\n<script lang=\"ts\">\r\nexport default {\r\n  name: 'BzFire',\r\n  version: '1.0.0'\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n@font-face {\r\n  font-family: 'BzAlibabaPuHuiTi';\r\n  src: url('./font/Alibaba_PuHuiTi_2.0_55_Regular_55_Regular.ttf') format('truetype');\r\n  font-weight: 400;\r\n  font-style: normal;\r\n  font-display: swap;\r\n}\r\n\r\n@font-face {\r\n  font-family: 'BzAlibabaPuHuiTi';\r\n  src: url('./font/Alibaba_PuHuiTi_2.0_75_SemiBold_75_SemiBold.ttf') format('truetype');\r\n  font-weight: 700;\r\n  font-style: normal;\r\n  font-display: swap;\r\n}\r\n\r\n@font-face {\r\n  font-family: 'BzDDIN';\r\n  src: url('./font/D-DIN.otf') format('opentype');\r\n  font-weight: 400;\r\n  font-style: normal;\r\n  font-display: swap;\r\n}\r\n\r\n@font-face {\r\n  font-family: 'BzDDIN';\r\n  src: url('./font/D-DIN-Bold.otf') format('opentype');\r\n  font-weight: 700 900;\r\n  font-style: normal;\r\n  font-display: swap;\r\n}\r\n\r\n@font-face {\r\n  font-family: 'UISDC';\r\n  src: url('./font/UISDC-BiaoTiHei.ttf') format('opentype');\r\n  font-weight: 700 900;\r\n  font-style: normal;\r\n  font-display: swap;\r\n}\r\n\r\n*{\r\n  font-family: 'BzAlibabaPuHuiTi';\r\n}\r\n\r\n.bz-fire {\r\n  width: 540px;\r\n  height: 928px;\r\n  display: flex;\r\n  box-sizing: border-box;\r\n  overflow: hidden;\r\n  color: #e8f8ff;\r\n  background: #061d35;\r\n  font-family: 'BzAlibabaPuHuiTi', Microsoft YaHei, PingFang SC, Arial, sans-serif;\r\n}\r\n\r\n// 左侧侧边栏\r\n.side-bar {\r\n  width: 24px;\r\n  flex-shrink: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  background: linear-gradient(180deg, #007b8f 0%, #005f73 50%, #003566 100%);\r\n\r\n  &__item {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    justify-content: center;\r\n    font-size: 16px;\r\n    font-weight: 700;\r\n    letter-spacing: 2px;\r\n    // writing-mode: vertical-rl;\r\n    text-orientation: upright;\r\n    color: #cfe8ff;\r\n\r\n    \r\n\r\n    &--fire {\r\n      background-color: #156A7A;\r\n      height: 220px;\r\n      &>div:nth-child(2){\r\n      color:#156A7A80;\r\n    }\r\n    }\r\n\r\n    &--prevention {\r\n      background-color: #054180;\r\n      flex: 1;\r\n      &>div:nth-child(2){\r\n      color:#05418080;\r\n    }\r\n    }\r\n  }\r\n}\r\n\r\n.content {\r\n  width: 516px;\r\n  height: 100%;\r\n  box-sizing: border-box;\r\n  padding: 10px;\r\n}\r\n\r\n// 通用模块样式\r\n.module {\r\n  width: 100%;\r\n  // margin-bottom: 12px;\r\n  border: 1px solid rgba(31, 117, 221, 0.3);\r\n  border-radius: 4px;\r\n  background: linear-gradient(180deg, rgba(4, 23, 48, 0.95), rgba(4, 31, 58, 0.85));\r\n  box-shadow: inset 0 0 20px rgba(16, 100, 200, 0.1);\r\n\r\n  &__header {\r\n    height: 28px;\r\n    display: flex;\r\n    align-items: center;\r\n    padding: 0 40px;\r\n    background: url('./img/bg_second_title.png') no-repeat center center;\r\n    background-size: 100% 100%;\r\n    border-bottom: 1px solid rgba(56, 189, 248, 0.3);\r\n    position: relative;\r\n    overflow: hidden;\r\n\r\n\r\n    &-title {\r\n      font-size: 20px;\r\n      line-height: 28px;\r\n      font-weight: 700;\r\n      color: #ffffff;\r\n      text-shadow: 0 0 8px rgba(96, 165, 250, 0.8), 0 0 4px rgba(96, 165, 250, 0.6);\r\n      letter-spacing: 1px;\r\n      font-family: 'UISDC';\r\n    }\r\n  }\r\n}\r\n\r\n// 消防系统「接」模块\r\n.fire-system {\r\n\r\n  &__top {\r\n    display: flex;\r\n    gap: 10px;\r\n    padding: 12px;\r\n   \r\n  }\r\n\r\n  &__card,&__card1{\r\n    flex: 1;\r\n    height: 72px;\r\n    display: flex;\r\n    align-items: center;\r\n    padding: 0 12px 0 58px;\r\n    border-radius: 8px;\r\n    background: url('./img/Group\\ 2136640505.png') no-repeat center center;\r\n    background-size: 100% 100%;\r\n    box-shadow: 0 0 12px rgba(251, 191, 36, 0.2), inset 0 0 12px rgba(251, 191, 36, 0.1);\r\n    position: relative;\r\n\r\n    &-icon {\r\n      margin-right: 12px;\r\n    }\r\n\r\n    &-info {\r\n      display: flex;\r\n      width: 100%;\r\n      height:32px;\r\n      padding-left: 9px;\r\n      flex-wrap: nowrap;\r\n      justify-content: space-between;\r\n      background: url('./img/bg_list_data.png') no-repeat center;\r\n   