            "date": 1782973855215,
            "name": "Commit-0",
            "content": "<template>\n  <div class=\"waterlog-list-modal\">\n    <div class=\"modal-header\">\n      <div class=\"header-title\">风险点位列表</div>\n      <button class=\"close-btn\" @click=\"handleClose\">×</button>\n    </div>\n\n    <div class=\"query-bar\">\n      <n-input\n        v-model:value=\"searchName\"\n        class=\"query-input\"\n        clearable\n        placeholder=\"请输入风险点名称\"\n        @keyup.enter=\"handleSearch\"\n      />\n      <n-select\n        v-model:value=\"selectedType\"\n        class=\"query-select\"\n        :options=\"riskTypeOptions\"\n        :bordered=\"false\"\n        @update:value=\"handleTypeChange\"\n      />\n      <n-button class=\"query-btn\" size=\"small\" @click=\"handleSearch\">查询</n-button>\n      <n-button class=\"query-btn\" size=\"small\" @click=\"handleReset\">重置</n-button>\n    </div>\n\n    <div class=\"modal-content\">\n      <n-data-table\n        class=\"waterlog-table\"\n        :columns=\"columns\"\n        :data=\"tableData\"\n        :bordered=\"false\"\n        :single-line=\"false\"\n        size=\"small\"\n      />\n    </div>\n\n    <div class=\"modal-footer\">\n      <n-pagination\n        :page=\"currentPage\"\n        :page-count=\"totalPage\"\n        :page-slot=\"5\"\n        @update:page=\"handlePageChange\"\n      />\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { h, onMounted, ref } from 'vue'\nimport { NButton, NDataTable, NInput, NPagination, NSelect } from 'naive-ui'\nconst emit = defineEmits(['close'])\n\nconst currentPage = ref(1)\nconst totalPage = ref(1)\nconst pageSize = 10\nconst tableData = ref([])\nconst searchName = ref('')\nconst selectedType = ref('all')\n\nconst riskLabelMap = {\n  'risk-all': '风险点总数',\n  'risk-flood': '洪灾风险',\n  'risk-waterlog': '内涝风险',\n  'risk-geology': '地灾风险'\n}\n\nconst riskTypeOptions = [\n  { label: '全部', value: 'all' },\n  { label: '风险点总数', value: 'risk-all' },\n  { label: '洪灾风险', value: 'risk-flood' },\n  { label: '内涝风险', value: 'risk-waterlog' },\n  { label: '地灾风险', value: 'risk-geology' }\n]\n\nconst fallbackRiskRows = [\n  { id: 'risk_1', name: '解放碑洪灾风险点', __riskType: 'risk-flood' },\n  { id: 'risk_2', name: '朝天门洪灾风险点', __riskType: 'risk-flood' },\n  { id: 'risk_3', name: '两路口内涝风险点', __riskType: 'risk-waterlog' },\n  { id: 'risk_4', name: '解放碑内涝风险点', __riskType: 'risk-waterlog' },\n  { id: 'risk_5', name: '李子坝地灾风险点', __riskType: 'risk-geology' },\n  { id: 'risk_6', name: '山城巷地灾风险点', __riskType: 'risk-geology' }\n]\n\nconst columns = [\n  {\n    title: '序号',\n    key: 'index',\n    width: 80,\n    render(_row, rowIndex) {\n      return h('span', {}, (currentPage.value - 1) * pageSize + rowIndex + 1)\n    }\n  },\n  { title: '风险点名称', key: 'name', minWidth: 220, ellipsis: true },\n  { title: '风险点类型', key: 'type', width: 180, ellipsis: true }\n]\n\nconst getRiskName = item => {\n  return String(item.name || item.riskName || item.deviceName || item.dvname || item.placeName || item.address || item.mountAddress || '-')\n}\n\nconst getRiskTypeName = item => {\n  return String(item.riskTypeName || item.riskType || item.typeName || item.type || item.categoryName || item.category || '-')\n}\n\nconst getFilteredRecords = () => {\n  const records = selectedType.value === 'all' || selectedType.value === 'risk-all'\n    ? fallbackRiskRows\n    : fallbackRiskRows.filter(item => item.__riskType === selectedType.value)\n  const filtered = searchName.value\n    ? records.filter(item => getRiskName(item).includes(searchName.value))\n    : records\n  const start = (currentPage.value - 1) * pageSize\n  return {\n    records: filtered.slice(start, start + pageSize),\n    pages: Math.max(1, Math.ceil(filtered.length / pageSize))\n  }\n}\n\nconst toTableRows = records => {\n  return records.map((item, index) => {\n    const type = item.__riskType || selectedType.value\n    return {\n      key: item.id || item.deviceCode || item.deviceNum || item.dvcode || `${type}_${index}`,\n      name: getRiskName(item),\n      type: selectedType.value === 'all' ? (riskLabelMap[type] || getRiskTypeName(item)) : riskLabelMap[selectedType.value]\n    }\n  })\n}\n\nconst getRiskPointList = async () => {\n  try {\n    const pageData = getFilteredRecords()\n    totalPage.value = pageData.pages || 1\n    tableData.value = toTableRows(pageData.records)\n  } catch (error) {\n    console.error('获取风险点列表失败:', error)\n    tableData.value = []\n    totalPage.value = 1\n  }\n}\n\nfunction handleClose() {\n  emit('close')\n}\n\nfunction handleSearch() {\n  currentPage.value = 1\n  getRiskPointList()\n}\n\nfunction handleReset() {\n  searchName.value = ''\n  selectedType.value = 'all'\n  currentPage.value = 1\n  getRiskPointList()\n}\n\nfunction handleTypeChange() {\n  currentPage.value = 1\n  getRiskPointList()\n}\n\nfunction handlePageChange(page) {\n  currentPage.value = page\n  getRiskPointList()\n}\n\nonMounted(() => {\n  getRiskPointList()\n})\n</script>\n\n<script>\nexport default {\n  name: 'WaterlogRiskPointList'\n}\n</script>\n\n<style lang=\"scss\" scoped>\n@import './waterlog-list-modal.scss';\n</style>\n"
        }
    ]
}